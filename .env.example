# Copy to .env and edit. Never commit .env.

# Application environment. One of: development, test, production.
APP_ENV=development

# PostgreSQL connection URL. Form: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://widgetplatform:change-me@postgres:5432/widgetplatform

# Configures the Postgres container (deploy/docker-compose.yml); must match the user in DATABASE_URL.
POSTGRES_USER=widgetplatform

# Configures the Postgres container (deploy/docker-compose.yml); must match the password in DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Configures the Postgres container (deploy/docker-compose.yml); must match the database name in DATABASE_URL.
POSTGRES_DB=widgetplatform

# Qdrant connection URL. Form: http://<host>:<port> or https://<host>:<port>
QDRANT_URL=http://qdrant:6333

# Configures both the Qdrant container (deploy/docker-compose.yml) and the app; the two must match. Placeholder only, replace for anything beyond local use. Sent as the "api-key" HTTP header; must not contain whitespace or control characters.
QDRANT_API_KEY=change-me

# Configures both the Qdrant container (deploy/docker-compose.yml) and the app; the two must match. A SEPARATE, server-enforced read-only credential for retrieve()'s own read path (distinct from QDRANT_API_KEY above). Placeholder only, replace for anything beyond local use. Sent as the "api-key" HTTP header; must not contain whitespace or control characters.
QDRANT_READ_ONLY_API_KEY=change-me

# Signs and verifies widget session tokens (JWT). Placeholder only, replace for anything beyond local use (generate one with: openssl rand -base64 32). At least 32 characters; must not contain whitespace or control characters.
JWT_SIGNING_KEY=change-me-change-me-change-me-change-me

# Optional: holds the previous signing key during a rotation, so tokens signed with either key still verify. Leave empty when not rotating.
JWT_SIGNING_KEY_PREVIOUS=

# pgcrypto passphrase for db_connections.encrypted_credentials (database-sync source credentials, encrypted at rest). Placeholder only, replace for anything beyond local use (generate one with: openssl rand -base64 32). At least 32 characters; must not contain whitespace or control characters.
DB_CONNECTION_ENCRYPTION_KEY=change-me-change-me-change-me-change-me

# OpenAI API key for the dense-embedding primitive (Task 2.5.a, docs/SPEC.md §5.1). Placeholder only, replace with a real key from https://platform.openai.com. Sent as an HTTP Authorization header value; must not contain whitespace or control characters.
OPENAI_API_KEY=change-me

# Optional: Anthropic API key for the secondary chat-model provider (Task 3.4.a, docs/SPEC.md §6.3's own ".with_fallbacks() to a secondary provider"). Leave empty to run with the primary (OpenAI) provider only -- a startup log warning records this. Replace with a real key from https://console.anthropic.com if set. Sent as an HTTP header value; must not contain whitespace or control characters.
ANTHROPIC_API_KEY=

# Host interface the API server binds to. Inside the container the API must listen on all interfaces; Compose publishes the port on the host's 127.0.0.1 only; use 127.0.0.1 when running outside a container.
API_HOST=0.0.0.0

# Port the API server listens on. Integer, 1-65535.
API_PORT=8000

# Optional: Phoenix tracing (Step 4.5, docs/SPEC.md §13). Leave empty to run with tracing disabled -- the API still starts and serves chats normally. Inside Docker Compose, the OTLP traces endpoint of the phoenix service: http://phoenix:6006/v1/traces.
PHOENIX_COLLECTOR_ENDPOINT=

# Optional: SMTP relay host (Task 4.3, backend/app/notifications/service.py). Already a real Settings field; added here now (Step 7.3 prep) because no .env.example line existed for it before. Leave empty to run with email disabled -- alerts/escalations are logged as "skipped_not_configured", never block a request. Kickoff decision #4 (D-113-email-postmark): Postmark's SMTP relay, sending from a dedicated subdomain (docs/deploy/RUNBOOK.md).
SMTP_HOST=

# Optional: SMTP relay port. Same Settings field as SMTP_HOST above; 587 (STARTTLS) is Settings' own default, matching docs/SPEC.md §14's "many hosts block port 25" caveat.
SMTP_PORT=587

# Optional: SMTP auth username. Leave empty together with SMTP_PASSWORD for a relay that needs no auth.
SMTP_USERNAME=

# Optional: SMTP auth password.
SMTP_PASSWORD=

# Optional: the sending address (distinct from SMTP_USERNAME -- some providers' auth user differs from the real From: address). Required together with SMTP_HOST for email to actually send.
SMTP_FROM_ADDRESS=

# Optional: the upload adapter's per-file size ceiling in bytes (Task 2.7.a). Already a real Settings field; added here now (Step 7.3 prep) because deploy/Caddyfile's own request_body limit reads this SAME variable -- one source of truth for the upload cap, never a second Caddy-only number. 20971520 = 20 * 1024 * 1024, matching that field's own literal default.
UPLOAD_MAX_SIZE_BYTES=20971520

# Optional: POST /api/v1/session's own per-site-key rate limit (Task 1.5.c, docs/SPEC.md §9). Requests allowed per window, per (IP, site_key) pair. Integer > 0.
SESSION_RATE_LIMIT_PER_SITE_KEY=10

# Optional: the window (seconds) SESSION_RATE_LIMIT_PER_SITE_KEY above counts against. Float > 0.
SESSION_RATE_LIMIT_PER_SITE_KEY_WINDOW_SECONDS=60

# Optional: POST /api/v1/session's own broader per-IP rate limit (Task 1.5.c, docs/SPEC.md §9), checked first and independent of which site key is targeted. Integer > 0.
SESSION_RATE_LIMIT_PER_IP=30

# Optional: the window (seconds) SESSION_RATE_LIMIT_PER_IP above counts against. Float > 0.
SESSION_RATE_LIMIT_PER_IP_WINDOW_SECONDS=60

# Optional: GET /api/v1/widget-appearance's own per-site-key rate limit (Step 7-follow-up Part C). Requests allowed per window, per (IP, site_key) pair. Integer > 0.
WIDGET_APPEARANCE_RATE_LIMIT_PER_SITE_KEY=120

# Optional: the window (seconds) WIDGET_APPEARANCE_RATE_LIMIT_PER_SITE_KEY above counts against. Float > 0.
WIDGET_APPEARANCE_RATE_LIMIT_PER_SITE_KEY_WINDOW_SECONDS=60

# Optional: GET /api/v1/widget-appearance's own broader per-IP rate limit (Step 7-follow-up Part C), checked first and independent of which site key is targeted. Integer > 0.
WIDGET_APPEARANCE_RATE_LIMIT_PER_IP=60

# Optional: the window (seconds) WIDGET_APPEARANCE_RATE_LIMIT_PER_IP above counts against. Float > 0.
WIDGET_APPEARANCE_RATE_LIMIT_PER_IP_WINDOW_SECONDS=60

# Optional: the dashboard's own install-snippet screen (Step 6.2) needs this to show a real data-base-url value (widget/loader/src/config.js: mandatory on the widget's own side, no built-in fallback). A platform-wide constant -- wherever THIS deployment's own API is publicly reachable -- not per-tenant. Leave empty until real public hosting exists (Phase 7); the install-snippet screen tells the tenant to ask their platform admin rather than show a wrong URL. Must be an https:// URL with a hostname if set.
PUBLIC_API_BASE_URL=

# --- Deploy / ops (not read by the backend app) --- Step 7.3 prep (ops track): deploy/Caddyfile, deploy/docker-compose.prod.yml, ops/backup/, ops/monitoring/. See docs/deploy/RUNBOOK.md for the full list and reasoning. Each of these has no backend Settings equivalent -- genuinely new, deploy-layer-only configuration.

# The dashboard hostname Caddy routes, read via {$VAR} substitution (kickoff decision #6: never hardcoded). A subdomain of softwareske.com.
DASHBOARD_HOSTNAME=app.softwareske.com

# The API hostname Caddy routes (same kickoff decision #6).
API_HOSTNAME=api.softwareske.com

# The widget hostname Caddy routes (same kickoff decision #6).
WIDGET_HOSTNAME=widget.softwareske.com

# The operator contact Caddy gives Let's Encrypt for automatic TLS.
CADDY_ACME_EMAIL=

# The host directory Caddy serves the built dashboard SPA from (deploy/docker-compose.prod.yml), populated by the dashboard's own build step at deploy time (docs/deploy/RUNBOOK.md).
DASHBOARD_DIST_DIR=/srv/samoflow/dashboard

# The host directory Caddy serves the built widget assets from (same mechanism as DASHBOARD_DIST_DIR above).
WIDGET_DIST_DIR=/srv/samoflow/widget

# Nightly backup (ops/backup/backup.sh): the ENCRYPTING (public) age key only -- the matching private key is never set here; it lives in a separate secrets file (docs/deploy/RUNBOOK.md) and is supplied only at restore-drill/real-restore time.
BACKUP_AGE_PUBLIC_KEY=

# The Qdrant collection ops/backup/backup.sh snapshots. Not a backend Settings field (app/qdrant.py's own COLLECTION_NAME is a plain module constant, not env-configurable) -- matches it by value, kept in sync by hand.
QDRANT_COLLECTION_NAME=knowledge_chunks

# The S3-compatible bucket nightly backups upload to (kickoff decision #8).
S3_BACKUP_BUCKET=

# The S3-compatible endpoint URL, passed to the AWS CLI's own --endpoint-url.
S3_BACKUP_ENDPOINT_URL=

# How many days of nightly backups ops/backup/backup.sh keeps before deleting older ones.
S3_BACKUP_RETENTION_DAYS=14

# The backup bucket's own access key -- stored separately from BACKUP_AGE_PUBLIC_KEY's matching private key (docs/deploy/RUNBOOK.md), never in the same place as each other.
AWS_ACCESS_KEY_ID=

# The backup bucket's own secret key.
AWS_SECRET_ACCESS_KEY=

# The AWS CLI's own required region setting; most S3-compatible providers ignore the value but still require it to be set.
AWS_DEFAULT_REGION=us-east-1

# The filesystem path ops/monitoring/check_resources.py checks disk usage on.
MONITORING_DISK_PATH=/

# The disk-usage percentage that triggers an alert email.
MONITORING_DISK_THRESHOLD_PERCENT=85

# The memory-usage percentage that triggers an alert email.
MONITORING_MEMORY_THRESHOLD_PERCENT=85

# Who ops/monitoring/check_resources.py emails when a threshold is crossed. Reads the SAME SMTP_* values above to send it.
MONITORING_ALERT_EMAIL=
